<%- include("partials/head", {title:"Users - "+siteName}) %>
<div class="admin-layout"><aside class="admin-side"><a class="brand" href="/admin"><span class="brand-mark">✦</span><span><%=siteName%><small style="display:block;font-family:Inter;font-size:9px;color:#9aaaba">ADMIN PANEL</small></span></a><nav class="admin-menu"><a href="/admin">▦ Dashboard</a><a class="active" href="/admin/users">♧ Users</a><a href="/admin/transactions">⇩ Transactions</a><a href="/admin/plans">◫ Plans</a><a href="/home">↗ User Site</a></nav></aside>
<main class="admin-main"><div class="admin-title"><h1>Users</h1></div><section class="admin-card"><table class="table"><thead><tr><th>ID</th><th>Name</th><th>Phone</th><th>Email</th><th>Balance</th><th>Recharge</th><th>Referral</th></tr></thead><tbody>
<% users.forEach(u=>{ %><tr><td><%=u.id%></td><td><%=u.name%></td><td><%=u.phone%></td><td><%=u.email%></td><td>₹<%=u.balance.toLocaleString("en-IN",{minimumFractionDigits:2})%></td><td>₹<%=u.recharge.toLocaleString("en-IN",{minimumFractionDigits:2})%></td><td><%=u.referralCode%></td></tr><% }) %>
</tbody></table></section></main></div></body></html>
