<%- include("partials/head", {title:"Login - "+siteName}) %>
<section class="auth-page">
  <div class="auth-card">
    <div class="brand" style="margin-bottom:20px"><span class="brand-mark">✦</span><span><%= siteName %></span></div>
    <div class="tabs"><a class="active" href="/login">Login</a><a href="/register">Sign Up</a></div>
    <h1>Welcome Back</h1><div class="sub">Enter your details to continue</div>
    <% if(flash){ %><div class="flash <%= flash.type %>"><%= flash.message %></div><% } %>
    <form method="post" action="/login">
      <div class="field"><label>Phone Number</label><input name="phone" placeholder="+91 mobile number" required></div>
      <div class="field"><label>Password</label><input type="password" name="password" placeholder="Password" required></div>
      <button class="btn btn-gold" style="width:100%">Login</button>
    </form>
    <p style="text-align:center;color:#b9c9d6">Don't have an account? <a style="color:#f4d77d;font-weight:800" href="/register">Sign Up</a></p>
  </div>
</section>
<%- include("partials/foot") %>
